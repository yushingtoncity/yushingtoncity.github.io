{
 "meta": {
  "source_repo": "mag7_daily_dashboard_2025",
  "generator": ".venv\\Scripts\\python.exe site_export.py (run from the repo root)",
  "provenance": "Source data is Yahoo Finance daily Close prices via yfinance, computed by the committed notebook mag7_daily_2025_journal.ipynb in the mag7_daily_dashboard_2025 repo. This JSON is a snapshot of the CSV generated by that notebook run. The CSV is gitignored, so a fresh clone must rerun the notebook (network required) to rebuild it before running site_export.py.",
  "description": "Rolling risk features and regime labels for 2025. MAG7_vol_20_ann is the 20-day rolling standard deviation of the equal-weight MAG7 daily return, annualized by sqrt(252). MAG7_SPY_corr_60 is the 60-day rolling correlation between the equal-weight MAG7 daily return and the SPY daily return. excess_ret is the equal-weight MAG7 daily return minus the SPY daily return. regime is a sign rule: risk_on when excess_ret > 0 and 20-day momentum > 0, risk_off when both are negative, neutral otherwise (including warm-up days). All 249 trading days (2025-01-02 to 2025-12-30) are included with no downsampling. Rolling warm-up periods are null.",
  "columns": {
   "Date": "trading date, YYYY-MM-DD (x axis)",
   "MAG7_vol_20_ann": "annualized volatility, decimal fraction per year (0.13 means 13 percent), null for the first 20 sessions",
   "MAG7_SPY_corr_60": "correlation coefficient, dimensionless, -1 to 1, null for the first 60 sessions",
   "excess_ret": "daily return difference, decimal fraction (0.01 means 1 percent), null for the first session",
   "regime": "label, one of risk_on, risk_off, neutral"
  },
  "units": "vol and excess_ret are decimal fractions rounded to 6 significant digits; correlation is rounded to 4 decimal places",
  "rows": 249
 },
